# ============================================================
# Caddy 反向代理設定
# ============================================================
#
# 【情況 A：已有網域名稱】（建議）
# 把下面這行改成你的網域，Caddy 會自動申請 Let's Encrypt 憑證，
# 之後網址就是 https://你的網域，全自動 HTTPS，免手動管理憑證。
#
#   maigret.你的網域.com {
#       reverse_proxy maigret:5000
#   }
#
# 【情況 B：暫時沒有網域，先用 IP 直接連】
# 把下面這段取消註解，並把 <VM_公網IP> 換成實際 IP。
# 此模式無法申請 Let's Encrypt（需要網域才能驗證），
# Caddy 會用自簽憑證，瀏覽器會顯示「不安全」警告，但連線仍會加密。
#
#   https://<VM_公網IP> {
#       tls internal
#       reverse_proxy maigret:5000
#   }
#
# ────────────────────────────────────────────────────────────
# 目前設定：使用 DuckDNS 免費子網域，自動申請 Let's Encrypt 憑證

maigret-tw.duckdns.org {
    reverse_proxy maigret:5000
}

# 仍保留 IP 直連（HTTP，無憑證），供網域尚未生效或臨時故障排除使用
# 注意：明確指定 http://<IP> 而非裸 ":80"，避免與上方網域的自動 HTTPS / ACME 驗證流程衝突
http://161.33.134.22 {
    reverse_proxy maigret:5000
}
